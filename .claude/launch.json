{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@rpg-chains/server", "dev"],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@rpg-chains/web", "dev"],
      "port": 3000
    },
    {
      "name": "server-localhost",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@rpg-chains/server", "dev"],
      "env": {
        "BETTER_AUTH_URL": "http://localhost:3001",
        "WEB_ORIGIN": "http://localhost:3000"
      },
      "port": 3001
    },
    {
      "name": "web-localhost",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@rpg-chains/web", "dev"],
      "env": { "NEXT_PUBLIC_API_URL": "http://localhost:3001" },
      "port": 3000
    }
  ]
}
