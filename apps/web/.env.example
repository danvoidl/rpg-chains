# Copy to apps/web/.env.local and fill in.
# The Fastify server: serves both Better Auth (/api/auth/*) and the REST API (/api/*).
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Cloudflare Turnstile site key, or "off" when the server runs CAPTCHA_PROVIDER=off. Cloudflare's
# test key 1x00000000000000000000AA always passes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="off"
