// As Sete Correntes — data model (Fase 0).
// Relational tables carry FK/queryable fields; polymorphic payloads live in jsonb
// validated by Zod at the app boundary (decision 6). The active battle lives in memory
// (decision 4); `BattleJournal` is only its copy for a restart (Fase 6). Published content is frozen in CampaignVersion.snapshot
// (decision 5). Connection URL and driver adapter come from prisma.config.ts / the client
// constructor (Prisma 7 direction), not from this datasource block.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * ------------------------------------------------------------- Better Auth ----
 */
// The auth User doubles as the domain "user" account (spec §2.1).

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  campaigns Campaign[]
  rooms     Room[]
  profiles  CampaignProfile[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

/**
 * ---------------------------------------------------------------- authoring ----
 */

model Campaign {
  id          String            @id @default(cuid())
  authorId    String
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name        String
  description String            @default("")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  chapters    Chapter[]
  classes     CharacterClass[]
  villains    Villain[]
  questions   Question[]
  items       Item[]
  versions    CampaignVersion[]
  rooms       Room[]

  @@index([authorId])
}

/// Immutable published snapshot of a campaign version (decision 5).
model CampaignVersion {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  publishedAt DateTime @default(now())
  rooms       Room[]

  @@unique([campaignId, version])
}

model Chapter {
  id                 String        @id @default(cuid())
  campaignId         String
  campaign           Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name               String
  underConstruction  Boolean       @default(false)
  order              Int           @default(0)
  entryNodeId        String?
  bossNodeId         String?
  /// Optional map behind the graph; node posX/posY are pixels of a width×height world.
  backgroundImageUrl String?
  backgroundWidth    Int?
  backgroundHeight   Int?
  /// Shown to each player on first reaching the chapter (Fase 5); empty text and no video = none.
  openingText        String        @default("")
  openingVideoUrl    String?
  nodes              ChapterNode[]
  edges              NodeEdge[]

  @@index([campaignId])
}

/// Draft graph node; polymorphic config in jsonb (decision 6).
model ChapterNode {
  id               String  @id @default(cuid())
  chapterId        String
  chapter          Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  type             String
  title            String  @default("")
  mandatory        Boolean @default(false)
  recommendedLevel Int?
  participantLimit Int?
  posX             Float   @default(0)
  posY             Float   @default(0)
  prerequisites    Json    @default("[]")
  config           Json    @default("{}")

  @@index([chapterId])
}

model NodeEdge {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  fromId    String
  toId      String

  @@index([chapterId])
}

model CharacterClass {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name           String
  description    String   @default("")
  artUrl         String?
  baseHp         Int
  baseEnergy     Int
  hpPerLevel     Int
  energyPerLevel Int
  maxSlots       Int
  baseWeaponId   String?
  skills         Skill[]

  @@index([campaignId])
}

/// Draft skill; the generic effect payload lives in jsonb (decision 6).
model Skill {
  id             String         @id @default(cuid())
  classId        String
  class          CharacterClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name           String
  iconUrl        String?
  text           String         @default("")
  energyCost     Int
  cooldownRounds Int
  unlockLevel    Int
  effect         Json

  @@index([classId])
}

model Villain {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name         String
  imageUrl     String?
  hp           Int
  strength     Int
  dexterity    Int
  intelligence Int
  defense      Int
  attacks      Json     @default("[]")
  /// Rewards per defeated instance (spec §6); `drops` is [{ itemId, chance }] (VillainDropSchema).
  xpReward     Int      @default(0)
  goldReward   Int      @default(0)
  drops        Json     @default("[]")

  @@index([campaignId])
}

model Question {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  type         String
  prompt       String
  options      Json?
  correctIndex Int?

  @@index([campaignId])
}

model Item {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category     String
  name         String
  slot         String?
  /// Shop price in gold (spec §6).
  price        Int      @default(0)
  requirements Json     @default("{}")
  defenseBonus Int      @default(0)
  weapon       Json?
  effect       Json?

  @@index([campaignId])
}

/**
 * ------------------------------------------------------------------ runtime ----
 */

model Room {
  id                String            @id @default(cuid())
  name              String
  campaignId        String
  campaign          Campaign          @relation(fields: [campaignId], references: [id])
  /// Current applied version; advances to newer compatible versions at safe points (decision 5).
  campaignVersionId String
  campaignVersion   CampaignVersion   @relation(fields: [campaignVersionId], references: [id])
  isPublic          Boolean           @default(true)
  accessCode        String?           @unique
  masterId          String
  master            User              @relation(fields: [masterId], references: [id])
  status            String            @default("open")
  /// The master's turn timer adjustments (RoomTurnTimersSchema); `{}` = platform defaults.
  turnTimers        Json              @default("{}")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  closedAt          DateTime?
  /// When the room beat the last chapter's boss (spec §7); cleared again if a new chapter arrives.
  completedAt       DateTime?
  /// Last sequence number of the room's progress facts; orders "after the campfire" (Fase 5).
  progressSeq       Int               @default(0)
  profiles          CampaignProfile[]
  history           History[]
  nodeClears        RoomNodeClear[]
  chapterStates     RoomChapterState[]
  battleJournals    BattleJournal[]
  tradeOffers       TradeOffer[]

  @@index([campaignId])
  @@index([isPublic, status])
}

/// A player's durable character in a room (spec §2.1, §3.7). classId references into the
/// room's current snapshot — validated at creation, not an FK; the publish compatibility gate
/// keeps it valid as the room rolls forward to newer versions (decision 5).
model CampaignProfile {
  id              String   @id @default(cuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId         String
  level           Int      @default(1)
  xp              Int      @default(0)
  availablePoints Int      @default(0)
  /// Private to the player (spec §6); rewards, shop and trades move it.
  gold            Int      @default(0)
  strength        Int      @default(0)
  dexterity       Int      @default(0)
  intelligence    Int      @default(0)
  currentHp       Int
  currentEnergy   Int
  downed          Boolean  @default(false)
  equipment       Json     @default("{}")
  inventory       Json     @default("[]")
  createdAt       DateTime @default(now())

  @@unique([roomId, userId])
  @@index([roomId])
}

/// A node the room cleared (spec §2.3, Fase 5 plan decisions 1 and 14). Only "cleared" is stored;
/// "unlocked" is derived by campaign-rules. `profileIds` = who took part, read by the defeat rollback.
model RoomNodeClear {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  chapterId  String
  nodeId     String
  seq        Int
  profileIds String[]
  createdAt  DateTime @default(now())

  @@unique([roomId, nodeId])
  @@index([roomId])
}

/// Per-chapter facts of a room: the campfire lit last (where a defeat returns) and whether the
/// chapter's boss was beaten (permanent).
model RoomChapterState {
  roomId         String
  room           Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  chapterId      String
  campfireNodeId String?
  campfireSeq    Int?
  clearedAt      DateTime?

  @@id([roomId, chapterId])
}

/// The copy of a running battle that survives a server restart (spec §3.7, Fase 6 plan decision
/// 6). Memory stays the source of truth while the process runs; this is only read on boot. The
/// content is not stored — it is cut again from the immutable version — nor the state, which is
/// the fold of the entries. Deleted in the write-back transaction, so a journal that exists is a
/// battle not yet written back.
model BattleJournal {
  battleId          String                @id
  roomId            String
  room              Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  campaignVersionId String
  /// `BattleNode`: id, title, type and participant limit.
  node              Json
  needsMaster       Boolean
  masterId          String
  /// `BattleParticipant[]` in formation order.
  participants      Json
  /// The room's turn timer adjustments when the battle started.
  turnTimers        Json
  createdAt         DateTime              @default(now())
  entries           BattleJournalEntry[]

  @@index([roomId])
}

/// One accepted batch of a journaled battle's log (secret events included), at its 1-based
/// position in the log.
model BattleJournalEntry {
  battleId String
  journal  BattleJournal @relation(fields: [battleId], references: [battleId], onDelete: Cascade)
  fromSeq  Int
  events   Json

  @@id([battleId, fromSeq])
}

/// A pending trade offer (spec §6, Fase 4 plan decision 9), copied from memory so it survives a
/// restart (Fase 6 plan decision 9). Nothing moves until it is accepted, so a lost row only costs
/// proposing again.
model TradeOffer {
  id            String   @id
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromProfileId String
  toProfileId   String
  /// `TradeSide`: gold and item ids.
  give          Json
  ask           Json
  expiresAt     DateTime

  @@index([roomId])
}

model History {
  id           String   @id @default(cuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId       String
  campaignName String
  finalData    Json
  createdAt    DateTime @default(now())

  @@index([userId])
}
